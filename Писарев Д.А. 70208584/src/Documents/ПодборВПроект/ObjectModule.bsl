Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    
    // Очищаем табличную часть перед заполнением
    ЭтотОбъект.ПодходящиеСтуденты.Очистить();
    
    // Если проект не выбран, выходим
    Если Не ЗначениеЗаполнено(НаучныйПроект) Тогда
        Возврат;
    КонецЕсли;
    
    // 1. Получаем требования проекта
    ТребуемыйБалл = НаучныйПроект.МинСреднийБалл;
    ТребуемыеНавыкиСтрока = СокрЛП(НаучныйПроект.ТребуемыеНавыки);
    
    // Превращаем строку навыков в массив (разделение по запятой)
    МассивТребуемыхНавыков = Новый Массив;
    Для Каждого СтекВ Слово Из СтрРазделить(ТребуемыеНавыкиСтрока, ",", Истина) Цикл
        МассивТребуемыхНавыков.Добавить(НСтр(СтрЗаменить(СтекВ, " ", "")));
    КонецЦикла;
    
    // 2. Делаем запрос к справочнику Студентов
    Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ
        |   Студенты.Ссылка КАК Студент,
        |   Студенты.СреднийБалл КАК СреднийБалл,
        |   Студенты.Навыки КАК Навыки
        |ИЗ
        |   Справочник.Студенты КАК Студенты
        |ГДЕ
        |   Студенты.СреднийБалл >= &ТребуемыйБалл";
        
    Запрос.УстановитьПараметр("ТребуемыйБалл", ТребуемыйБалл);
    
    РезультатЗапроса = Запрос.Выполнить();
    Выборка = РезультатЗапроса.Выбрать();
    
    // 3. Анализируем каждого студента, прошедшего по баллам
    Пока Выборка.Следующий() Цикл
        
        НавыкиСтудентаСтрока = НСтр(СокрЛП(Выборка.Навыки));
        
        // Считаем простые совпадения навыков для демонстрации ИИ-логики матчинга
        Совпадений = 0;
        ВсегоТребуемых = МассивТребуемыхНавыков.Количество();
        
        Если ВсегоТребуемых > 0 Тогда
            Для Каждого Навык Из МассивТребуемыхНавыков Цикл
                Если СтрНайти(НавыкиСтудентаСтрока, Навык) > 0 Тогда
                    Совпадений = Совпадений + 1;
                КонецЕсли;
            КонецЦикла;
            
            Процент = (Совпадений / ВсегоТребуемых) * 100;
        Иначе
            Процент = 100;
        КонецЕсли;
        
        // Если есть совпадения навыков (или процент > 0), добавляем в табличную часть
        Если Процент > 0 Тогда
            СтрокаТЧ = ЭтотОбъект.ПодходящиеСтуденты.Добавить();
            СтрокаТЧ.Студент = Выборка.Студент;
            СтрокаТЧ.ПроцентСовпадения = Процент;
        КонецЕсли;
        
    КонецЦикла;

КонецПроцедуры